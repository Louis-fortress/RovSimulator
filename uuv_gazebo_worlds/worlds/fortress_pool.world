<sdf version="1.5">
    <world name="fortress_world">
        <physics type="ode">
            <max_step_size>0.01</max_step_size>
            <real_time_factor>1</real_time_factor>
            <real_time_update_rate>100</real_time_update_rate>
            <ode>
                <solver>
                <type>quick</type>
                <iters>50</iters>
                <sor>1.2</sor>
                </solver>
            </ode>
        </physics>

        <!-- Origin placed somewhere in the middle of the North Sea  -->
        <spherical_coordinates>
            <latitude_deg>56.71897669633431</latitude_deg>
            <longitude_deg>3.515625</longitude_deg>
        </spherical_coordinates>

        <!-- Global light source -->
        <light type="directional" name="sun1">
            <pose>50 0 150 0 0 0</pose>
            <diffuse>1 1 1 1</diffuse>
            <specular>.1 .1 .1 1</specular>
            <direction>0.3 0.3 -1</direction>
            <cast_shadows>false</cast_shadows>
        </light>

        <!-- Global light source -->
        <light type="directional" name="sun_diffuse">
            <pose>-50 0 -150 0 0 0</pose>
            <diffuse>0.6 0.6 0.6 1</diffuse>
            <specular>0 0 0 1</specular>
            <direction>-0.3 -0.3 -1</direction>
            <cast_shadows>false</cast_shadows>
        </light>

        <include>
            <uri>model://ned_frame</uri>
            <pose>0 0 0 0 0 0</pose>
        </include>

        <!-- Global light source -->
        <include>
            <uri>model://sun</uri>
        </include>

        <!-- Fortress Pool -->
        <include>
            <uri>model://fortress_pool</uri>
            <pose>0 0 0 0 0 0</pose>
        </include>

        <node name="plankton_global_sim_time"
            pkg="plankton_utils"
            exec="plankton_global_sim_time"
            output="screen">
            <param name="use_sim_time" value="$(var use_sim_time)"/>
        </node>

        <plugin name="gazebo_ros" filename="libgazebo_ros_state.so">
            <!-- NB: omitting <ros> element, the namespace is still correctly read,
            but is it an intended behaviour ?-->
            <ros>
                <namespace>/gazebo</namespace>
            </ros>
        </plugin>

        <plugin name="underwater_current_plugin" filename="libuuv_underwater_current_ros_plugin.so">
            <namespace>hydrodynamics</namespace>
            <constant_current>
                <topic>current_velocity</topic>
                <velocity>
                    <mean>0</mean>
                    <min>0</min>
                    <max>8</max>
                    <mu>0.0</mu>
                    <noiseAmp>0.0</noiseAmp>
                </velocity>

                <horizontal_angle>
                    <mean>0</mean>
                    <min>-3.141592653589793238</min>
                    <max>3.141592653589793238</max>
                    <mu>0.0</mu>
                    <noiseAmp>0.0</noiseAmp>
                </horizontal_angle>

                <vertical_angle>
                    <mean>0</mean>
                    <min>-3.141592653589793238</min>
                    <max>3.141592653589793238</max>
                    <mu>0.0</mu>
                    <noiseAmp>0.0</noiseAmp>
                </vertical_angle>
            </constant_current>
        </plugin>

        <plugin name="sc_interface" filename="libuuv_sc_ros_interface_plugin.so"/>
    </world>
</sdf>