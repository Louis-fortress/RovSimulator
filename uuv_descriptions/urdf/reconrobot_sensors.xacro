<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- IMU  -->
  <xacro:default_imu_macro
    namespace="${namespace}"
    parent_link="${namespace}/base_link"
    inertial_reference_frame="${inertial_reference_frame}">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:default_imu_macro>

  <!-- Magnetometer  -->
  <xacro:default_magnetometer namespace="${namespace}" parent_link="${namespace}/base_link"/>

  <!-- Pressure  -->
  <xacro:default_pressure_macro namespace="${namespace}"
  parent_link="${namespace}/base_link">
    <origin xyz="0.382 0.096 -0.04" rpy="0 0 0"/>
  </xacro:default_pressure_macro>

  <!-- Mount a Pose 3D sensor. -->
  <xacro:default_pose_3d_macro
    namespace="${namespace}"
    parent_link="${namespace}/base_link"
    inertial_reference_frame="${inertial_reference_frame}" />

  <!-- DVL  -->
  <xacro:default_dvl_macro
    namespace="${namespace}"
    parent_link="${namespace}/base_link"
    inertial_reference_frame="${inertial_reference_frame}">
    <origin xyz="-0.898 0 0.01" rpy="0 ${0.5*pi} 0"/>
  </xacro:default_dvl_macro>

  <!-- <xacro:forward_looking_sonar
    namespace="${namespace}"
    suffix=""
    parent_link="${namespace}/base_link"
    topic="sonar_image"
    mass="0.015"
    update_rate="15"
    samples="512"
    fov="2.094395"
    width="512"
    height="512">
    <inertia
        ixx="0.00001"
        ixy="0.0"
        ixz="0.0"
        iyy="0.00001"
        iyz="0.0"
        izz="0.00001" />
    <origin xyz="0.898 0 0.082" rpy="0 0.0 0"/>
  </xacro:forward_looking_sonar> -->
  <xacro:forward_multibeam_p900
    namespace="${namespace}"
    parent_link="${namespace}/base_link">
  <origin xyz="0.911 0 0.082" rpy="0 0 0"/>
</xacro:forward_multibeam_p900>
</robot>