<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!--
    Center of buoyancy according to eq. (3.1) p. 28 in Berg2012.
    The original values, [0.0822, -0.00773, 0.3872] however, seem to
    assume NWU (otherwise cob is below cog?).
    -->
    <xacro:property name="cob" value="0.0 0.0 0.1379"/>

    <!-- Volume, see p.31 in Berg2012 -->
    <xacro:property name="volume" value="0.159"/>

    <xacro:macro name="reconrobot_hydro_model" params="namespace">
        <link name="${namespace}/base_link">
            <neutrally_buoyant>0</neutrally_buoyant>
            <volume>${volume}</volume>
            <box>
                <width>0.548</width>
                <length>1.97</length>
                <height>0.415</height>
            </box>
            <center_of_buoyancy>${cob}</center_of_buoyancy>
            <hydrodynamic_model>
                <type>fossen</type>
                <!-- Added mass: see p.28 in Berg2012 -->
                <added_mass>
                    9.131   0.098   0.563   0.017  18.511   0.013
                    0.073  51.804  -0.180  -4.968  -0.102   0.167
                    0.292  -0.093 364.562   0.274   6.813   0.011
                    0.013  -4.908   0.268   1.432   0.025   0.090
                    18.129  -0.003   6.769   0.029  45.449   0.015
                    0.012   0.169   0.199   0.092   0.030   5.932
                </added_mass>
                <!-- Linear damping: see p.31 in Berg2012 -->
                <linear_damping>
                    -12.0 -60.0 -80.0 -10.0 -20.0 -10.0
                </linear_damping>
                <!-- Non-linear damping: see p.30 in Berg2012 -->
                <quadratic_damping>
                    -15.0 -190.0 -236.0 -20.0 -50.0 -20.0
                </quadratic_damping>
            </hydrodynamic_model>
        </link>
    </xacro:macro>

</robot>