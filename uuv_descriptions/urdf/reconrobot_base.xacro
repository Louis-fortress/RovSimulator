<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="reconrobot">
  <xacro:include filename="$(find uuv_descriptions)/urdf/common.urdf.xacro"/>
  <xacro:include filename="$(find uuv_gazebo_ros_plugins)/urdf/snippets.xacro"/>
  <xacro:include filename="$(find uuv_sensor_ros_plugins)/urdf/sensor_snippets.xacro"/>
  <xacro:property name="namespace" value="reconrobot"/>
  <xacro:property name="base_link_mesh_file" value="file://$(find uuv_descriptions)/meshes/reconrobot_edited.stl"/>
  
  <!--Mass in kg-->
  <xacro:property name="mass" value="163.10"/>
  <xacro:macro name="reconrobot_base" params="namespace *gazebo inertial_reference_frame">
    <!--base_link according to ROS conventions: x forward, z up-->
    <link name="${namespace}/base_link">
        <inertial>
            <origin xyz="0.0 0.0 -0.04" rpy="0.0 0.0 0.0"/>
            <mass value="${mass}"/>
            <inertia ixx="4.06"  ixy="0.07"  ixz="-0.34"
                      iyy="29.18" iyz="0.02"
                                  izz="30.45"/>
        </inertial>
        <visual name="">
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <mesh filename="${base_link_mesh_file}" scale="1 1 1"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <mesh filename="${base_link_mesh_file}" scale="1 1 1"/>
            </geometry>
        </collision>
    </link>

    <!-- Set up hydrodynamic plugin given as input parameter -->
    <xacro:insert_block name="gazebo"/>

    <xacro:include filename="$(find uuv_descriptions)/urdf/reconrobot_actuators.xacro"/>
    <xacro:include filename="$(find uuv_descriptions)/urdf/reconrobot_sensors.xacro"/> 
  </xacro:macro>
</robot>